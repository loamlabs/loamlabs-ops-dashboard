# Alpina stock job: every setting. On the NAS these are typed into the project (docker-compose.yml, the "environment" part); this file is only the list.
# NEVER put real values in this file, in GitHub, or in any synced folder.
HOSS_LOGIN_USER=
HOSS_LOGIN_PASSWORD=
SHOPIFY_SHOP_NAME=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
RESEND_API_KEY=
REPORT_EMAIL=
ALPINA_THRESHOLD=32
ALPINA_INTERVAL_DAYS=3
# which branch of the GitHub repo the job takes its code from (main after the pull request is merged)
REPO_REF=main
TZ=America/New_York
